DEBUG=false
SECRET_KEY=GENERATE_WITH_OPENSSL
ALLOWED_HOSTS=emeraldrozalia.ie,www.emeraldrozalia.ie
CSRF_TRUSTED_ORIGINS=https://emeraldrozalia.ie
POSTGRES_DB=emerald_rozalia_marketing
POSTGRES_USER=emerald_rozalia
POSTGRES_PASSWORD=GENERATE_STRONG_PASSWORD
DATABASE_URL=postgresql://emerald_rozalia:GENERATE_STRONG_PASSWORD@postgres:5432/emerald_rozalia_marketing
REDIS_PASSWORD=GENERATE_DIFFERENT_PASSWORD
REDIS_URL=redis://:GENERATE_DIFFERENT_PASSWORD@redis:6379/0
OWNER_PASSWORD=GENERATE_OWNER_PASSWORD
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=urmos@rozalia.ie
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=Emerald Rozalia Limited <urmos@rozalia.ie>
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Absolute base for tracking pixels, click redirects, unsubscribe and action
# links. These are opened from a mail client, so they cannot be relative — set
# this or every link in an outgoing campaign is broken.
SITE_URL=https://emeraldrozalia.ie

# Engagement review. A campaign below either figure raises an attention item
# and the campaign.underperforming event, once, a day after it was sent.
OPEN_RATE_TARGET=15.0
CLICK_RATE_TARGET=2.0

# Attribution: how many days back a campaign may reach to claim a conversion.
ATTRIBUTION_WINDOW_DAYS=30

# Escalation ladder for owner attention, in hours past the deadline. Each step
# raises the item one severity; reaching critical alerts the owner again.
ESCALATION_STEPS=4,24,72

# Owner's WhatsApp number for critical alerts, digits only. Blank disables the
# WhatsApp channel; email alerts are sent either way.
OWNER_WHATSAPP=

# Deliverability and consent policy.
BOUNCE_LIMIT=3
CONSENT_EXPIRY_MONTHS=24
DORMANT_MONTHS=6

